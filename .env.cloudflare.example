# Production overrides for Cloudflare (gitignored).
# Copied/merged on top of apps/web/.env.local by: npm run cf:env
#
# Required overrides (do not use localhost):
NEXTAUTH_URL=https://pagespeed.YOUR_DOMAIN
AUTH_URL=https://pagespeed.YOUR_DOMAIN

# Production database (Neon / Supabase / etc.)
# DATABASE_URL=postgresql://...

# Optional extras
# CRON_SECRET=
# DATABASE_DISABLED=false
