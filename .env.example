# Copy to apps/web/.env.local for local development

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://webagent:webagent@localhost:5432/webagent

# Redis (optional until BullMQ jobs are wired)
REDIS_URL=redis://localhost:6379

# Auth (Auth.js / NextAuth — fill when enabling Google OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Crawler
CRAWLER_USER_AGENT=WebagentBot/0.1 (+https://localhost)
CRAWLER_MAX_PAGES=500
