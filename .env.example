# Copy to apps/web/.env.local for local development
# Do NOT put real secrets in this file (it is committed to git).

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://webagent:webagent@localhost:5432/webagent

# Redis (optional until BullMQ jobs are wired)
REDIS_URL=redis://localhost:6379

# Auth (Auth.js / NextAuth — fill when enabling Google OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=

# Optional local-only auth bypass for server helpers
DEV_BYPASS_AUTH=false

# Cron / job runner (POST /api/cron/run). Required in production.
CRON_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GA4 property id (OAuth sync still required for live metrics)
GA4_PROPERTY_ID=

# Set true to force file-store mode even if DATABASE_URL is set
DATABASE_DISABLED=false

# Optional: generic Google Cloud API key (Console ? Credentials ? API key)
# Can be restricted to PageSpeed Insights API; used as fallback for PAGESPEED_API_KEY
GOOGLE_API_KEY=

# PageSpeed Insights API (server-only; never expose to the browser)
# https://developers.google.com/speed/docs/insights/v5/get-started
# Prefer PAGESPEED_API_KEY; if empty, falls back to GOOGLE_API_KEY
PAGESPEED_API_KEY=

# Optional: local proxy for Google APIs (Clash etc.)
PAGESPEED_HTTP_PROXY=
HTTPS_PROXY=
HTTP_PROXY=

# LLM (Gemini: get key from https://aistudio.google.com/apikey)
# Note: Gemini blocks some regions; use overseas Clash exit or set LLM_BASE_URL to a relay.
# Comma-separated fallback list; first model that succeeds is used.
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.5-flash
LLM_BASE_URL=

# Crawler
CRAWLER_USER_AGENT=WebagentBot/0.1 (+https://localhost)
CRAWLER_MAX_PAGES=500
